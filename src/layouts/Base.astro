---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Lokesh Nanda — data engineering, cloud and AI products. Apps, interactive demos and writing from 12+ years of building.',
  ogImage = '/og/site.png',
} = Astro.props;

const nav = [
  { href: '/demos/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '/learnings/', label: 'Learnings' },
  { href: '/resume/', label: 'Resume' },
  { href: '/search/', label: 'Search' },
  { href: 'https://github.com/LokeshNanda', label: 'GitHub' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Lokesh Nanda — Blog" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* display=optional, not swap: the fallbacks below these two families are
       Segoe UI and Georgia, which exist on Windows but not on Android or
       Linux. Where they are missing the generic sans and serif have quite
       different metrics, so a post-paint swap reflowed all of body > main and
       measured 0.346 CLS on CI, well into Google's "poor" band. With optional
       the browser keeps the fallback rather than swapping late, so nothing
       moves; visitors get the real faces once the fonts are cached. Revisit
       when the fonts are self-hosted with metric overrides. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=optional"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BXS05FENFB" />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-BXS05FENFB');`}
          />
        </>
      )
    }
    {/* Client-side error reporting: a ~1.3 KB hand-rolled Sentry reporter
       instead of the official browser SDK. Not a style choice: lighthouserc.cjs
       hard-fails the build at more than two scripts per page, and the SDK would
       be a third. An inline script adds document bytes but no request. Events
       go straight to Sentry's envelope API, authenticated by the public key in
       the DSN, which is safe to ship in the page because a DSN can only write
       events in, never read anything out. The chat widget routes its otherwise
       swallowed errors here via the native reportError(). Guards: production
       hostname only, cross-origin "Script error." noise dropped, at most five
       events per page load, repeats deduped. Mirrors workers/chat/src/sentry.js
       on the Worker side. */}
    <script is:inline>
      (() => {
        const DSN = 'https://7cbbafe7e98b1df658e9e4e13ae2c127@o4512011817779200.ingest.us.sentry.io/4512011842945024';
        if (!DSN || location.hostname !== 'lokeshnanda.com') return;
        const m = DSN.match(/^https:\/\/([^@:/]+)@([^/]+)\/(\d+)$/);
        if (!m) return;
        const url = `https://${m[2]}/api/${m[3]}/envelope/?sentry_key=${m[1]}&sentry_version=7`;
        const seen = new Set();
        let left = 5;
        const frames = (stack) => {
          const out = [];
          for (const line of String(stack || '').split('\n')) {
            const f =
              /^\s*at (?:(.+?) \()?(.+?):(\d+):(\d+)\)?\s*$/.exec(line) ||
              /^\s*(?:(.*?)@)?(.+?):(\d+):(\d+)\s*$/.exec(line);
            if (f) out.unshift({ function: f[1] || '?', filename: f[2], lineno: +f[3], colno: +f[4], in_app: true });
          }
          return out;
        };
        const send = (type, value, stack) => {
          if (!left || seen.has(type + value)) return;
          left--;
          seen.add(type + value);
          const id = [...crypto.getRandomValues(new Uint8Array(16))]
            .map((b) => b.toString(16).padStart(2, '0'))
            .join('');
          const fr = frames(stack);
          fetch(url, {
            method: 'POST',
            keepalive: true,
            body:
              JSON.stringify({ event_id: id, sent_at: new Date().toISOString() }) +
              '\n{"type":"event"}\n' +
              JSON.stringify({
                event_id: id,
                timestamp: Date.now() / 1000,
                platform: 'javascript',
                level: 'error',
                environment: 'production',
                request: { url: location.href, headers: { 'User-Agent': navigator.userAgent } },
                exception: {
                  values: [
                    { type, value: String(value).slice(0, 500), stacktrace: fr.length ? { frames: fr } : undefined },
                  ],
                },
              }),
          }).catch(() => {});
        };
        addEventListener('error', (e) => {
          if (e.message === 'Script error.') return;
          const err = e.error;
          if (err) send(err.name || 'Error', err.message || String(err), err.stack);
          else send('Error', e.message || 'unknown error', null);
        });
        addEventListener('unhandledrejection', (e) => {
          const r = e.reason;
          if (r instanceof Error) send(r.name || 'Error', r.message, r.stack);
          else send('UnhandledRejection', String(r), null);
        });
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="site-name">Lokesh Nanda</a>
        <nav class="site-nav" aria-label="Site">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch between dark and light mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <p class="colophon">
          New projects and posts appear here automatically —
          <a href="/colophon/">see how this site works</a>.
        </p>
        <p class="footer-links">
          <a href="/now/">Now</a> ·
          <a href="/reading/">Reading</a> ·
          <a href="https://github.com/LokeshNanda">GitHub</a> ·
          <a href="https://www.linkedin.com/in/lokeshnanda/">LinkedIn</a> ·
          <a href="https://status.lokeshnanda.com/">Status</a> ·
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>

    <ChatWidget />

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    position: sticky;
    top: 0;
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 0.6rem 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    flex-wrap: wrap;
  }
  .site-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 550;
  }
  .site-nav a {
    color: var(--dim);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--primary);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--dim);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--primary);
    border-color: var(--primary);
  }
  /* Small screens: name + toggle share the top row, nav wraps below */
  @media (max-width: 680px) {
    .theme-toggle { order: 2; margin-left: auto; }
    .site-nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
      gap: 0.3rem 1rem;
    }
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.4rem;
    padding-bottom: 2rem;
    font-size: 0.82rem;
    color: var(--dim);
  }
  .colophon { margin: 0; }
  .colophon a { color: var(--dim); }
  .colophon a:hover { color: var(--primary); }
  .footer-links { margin: 0; }
  .footer-links a { color: var(--dim); }
  .footer-links a:hover { color: var(--primary); }
</style>
