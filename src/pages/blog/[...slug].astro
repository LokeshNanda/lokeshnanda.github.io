---
import Base from '../../layouts/Base.astro';
import Related from '../../components/Related.astro';
import Subscribe from '../../components/Subscribe.astro';
import ProseEnhance from '../../components/ProseEnhance.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
---

<Base
  title={`${post.data.title} — Lokesh Nanda`}
  description={post.data.description}
  ogImage={`/og/blog/${post.id}.png`}
>
  <article class="wrap post" data-pagefind-body>
    <header class="post-header">
      <p class="post-meta">
        {fmt(post.data.date)} · {minutes} min read
        {post.data.updated && <span> · Updated {fmt(post.data.updated)}</span>}
        {post.data.tags.length > 0 && (
          <span>
            {post.data.tags.map((tag) => (
              <> · <a class="tag-link" href={`/tags/${tag}/`}>{tag}</a></>
            ))}
          </span>
        )}
      </p>
      <h1 class="display post-title">{post.data.title}</h1>
      {post.data.canonical && (
        <p class="canonical-note">
          Originally published <a href={post.data.canonical}>here</a>.
        </p>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <Subscribe />
    <Related collection="posts" id={post.id} tags={post.data.tags} />
    <ProseEnhance />
    <footer class="post-footer">
      <a href="/blog/">← All posts</a>
    </footer>
  </article>
</Base>

<style>
  .post { padding-top: 3.5rem; }
  .post-meta { font-size: 0.82rem; color: var(--dim); }
  .tag-link { color: inherit; text-decoration: none; }
  .tag-link:hover { color: var(--primary); }
  .post-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); margin-top: 0.6rem; max-width: 46rem; }
  .canonical-note { font-size: 0.8rem; color: var(--dim); margin-top: 0.8rem; }
  .prose { margin-top: 2.2rem; }
  .post-footer { margin-top: 3.5rem; font-size: 0.8rem; }
</style>
