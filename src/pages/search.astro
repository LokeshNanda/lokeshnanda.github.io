---
import Base from '../layouts/Base.astro';
// Pagefind indexes the built site (npm run build), so /pagefind/* assets only
// exist in production builds — the dev-mode fallback below explains that.
---

<Base
  title="Search — Lokesh Nanda"
  description="Search every post, weekly learnings note and page on lokeshnanda.com."
>
  <section class="wrap search-page">
    <p class="eyebrow">Search</p>
    <h1 class="display">Find anything on this site</h1>
    <p class="lede">Posts, weekly learnings and pages — indexed at build time, searched in your browser.</p>
    <div id="search" class="search-box"></div>
    <noscript><p>Search needs JavaScript. Try the <a href="/blog/">blog index</a> or <a href="/tags/">tags</a> instead.</p></noscript>
  </section>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
  const s = document.createElement('script');
  s.src = '/pagefind/pagefind-ui.js';
  s.onload = () => {
    new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    document.querySelector('#search input')?.focus();
  };
  s.onerror = () => {
    document.getElementById('search').innerHTML =
      '<p class="search-dev-note">Search index not found — it is generated by <code>npm run build</code> and unavailable in dev mode.</p>';
  };
  document.head.appendChild(s);
</script>

<style is:global>
  .search-page { padding-top: 3.5rem; min-height: 55vh; }
  .search-page .display { margin-top: 0.6rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .search-page .lede { margin-top: 1rem; }
  .search-box { margin-top: 2rem; max-width: 44rem; }
  .search-dev-note { color: var(--dim); font-size: 0.9rem; }

  /* Theme Pagefind's UI with the site palette */
  .search-box {
    --pagefind-ui-primary: var(--primary);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--primary-wash);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: inherit;
  }
  .search-box .pagefind-ui__search-input { font-weight: 500; }
  .search-box .pagefind-ui__result-link { color: var(--primary); }
  .search-box .pagefind-ui__result mark,
  .search-box mark {
    background: var(--primary-wash);
    color: var(--primary);
    border-radius: 3px;
    padding: 0 0.15em;
  }
</style>
