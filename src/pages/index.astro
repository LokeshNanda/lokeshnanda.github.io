---
import Base from '../layouts/Base.astro';
import Manifest from '../components/Manifest.astro';
import { getCollection } from 'astro:content';
import catalog from '../../data/catalog.json';

const apps = catalog.items.filter((i) => i.category === 'app');
const demos = catalog.items.filter((i) => i.category === 'demo');
const learning = catalog.items.filter((i) => i.category === 'learning');

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base title="Lokesh Nanda — data engineering, cloud & AI products">
  <!-- Hero -->
  <div class="hero-bleed">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">Data engineering · Cloud · AI products</p>
        <h1 class="display">
          The resume says twelve years.
          <em class="serif-turn">The work is right here.</em>
        </h1>
        <p class="lede">
          I lead data platform and AI builds for a living, and I can't stop shipping side
          projects. Everything on this page is live: apps to open, demos to click through,
          notes to read.
        </p>
        <p class="hero-actions">
          <a class="btn btn-primary" href="/demos/">Browse the work</a>
          <a class="btn" href="/resume/">Read the resume</a>
        </p>
      </div>
      <div class="hero-manifest">
        <Manifest />
      </div>
    </section>
  </div>

  <!-- Apps -->
  <section class="wrap section" id="apps">
    <p class="eyebrow">Apps</p>
    <h2 class="section-title">Tools I built because I needed them</h2>
    <div class="card-grid">
      {apps.map((app) => (
        <a class="card" href={app.url}>
          <h3>{app.name}</h3>
          <p class="mono card-domain">{app.domain.toLowerCase()}</p>
          <p>{app.description}</p>
          <span class="mono card-go">open app →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Concept demos -->
  <section class="wrap section" id="demos">
    <p class="eyebrow">Concept demos</p>
    <h2 class="section-title">One command centre per industry</h2>
    <p class="section-note">
      Built on simulated data. The engineering is real; the numbers aren't.
    </p>
    <ul class="demo-list">
      {demos.map((demo) => (
        <li>
          <a class="demo-row" href={demo.url}>
            <span class="demo-name">{demo.name}</span>
            <span class="badge badge-domain">{demo.domain}</span>
            <span class="badge badge-simulated">simulated data</span>
            <span class="mono demo-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mono more-link"><a href="/demos/">full catalog →</a></p>
  </section>

  <!-- Reference shelf + writing -->
  <section class="wrap section split" id="learning">
    <div>
      <p class="eyebrow">Engineering notes</p>
      <h2 class="section-title">The reference shelf</h2>
      <ul class="plain-list">
        {learning.map((item) => (
          <li>
            <a href={item.url}>{item.name}</a>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Blog</p>
      <h2 class="section-title">Recent writing</h2>
      <ul class="plain-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="mono post-date">{fmt(post.data.date)}</p>
          </li>
        ))}
      </ul>
      <p class="mono more-link"><a href="/blog/">all posts →</a></p>
    </div>
  </section>

  <!-- Contact -->
  <section class="wrap section contact" id="contact">
    <p class="eyebrow">Contact</p>
    <p class="contact-statement">
      Hiring for data, platform or AI work? <em>The inbox is open.</em>
    </p>
    <p class="mono contact-links">
      <a href="mailto:hello@lokeshnanda.com">hello@lokeshnanda.com</a>
      <span aria-hidden="true">·</span>
      <a href="https://www.linkedin.com/in/lokeshnanda/">linkedin</a>
    </p>
  </section>
</Base>

<style>
  .hero-bleed {
    position: relative;
  }
  /* Grid texture on a pseudo-element so the fade mask never touches the content */
  .hero-bleed::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent);
    mask-image: linear-gradient(to bottom, black 55%, transparent);
    pointer-events: none;
  }
  .hero-bleed > .hero {
    position: relative;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }
  .hero-copy .eyebrow { margin-bottom: 1rem; }
  .serif-turn {
    display: block;
    font-family: var(--font-prose);
    font-style: italic;
    font-weight: 500;
    color: var(--petrol);
    letter-spacing: -0.01em;
  }
  .lede { margin-top: 1.2rem; }
  .hero-actions { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
  }
  .btn:hover { border-color: var(--petrol); color: var(--petrol); }
  .btn-primary {
    background: var(--petrol);
    border-color: var(--petrol);
    color: #f4faf8;
  }
  .btn-primary:hover { background: var(--petrol-deep); border-color: var(--petrol-deep); color: #f4faf8; }

  .section { padding-top: 3.5rem; }
  .section .eyebrow { margin-bottom: 0.4rem; }
  .section-note { color: var(--dim); max-width: 40rem; margin-top: 0.5rem; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--petrol); transform: translateY(-2px); }
  .card h3 { font-size: 1.05rem; font-weight: 650; }
  .card-domain { font-size: 0.68rem; color: var(--petrol); letter-spacing: 0.08em; margin: 0; }
  .card p:not(.card-domain) { margin: 0.2rem 0 0; font-size: 0.9rem; color: var(--dim); flex: 1; }
  .card-go { font-size: 0.72rem; color: var(--dim); margin-top: 0.6rem; }
  .card:hover .card-go { color: var(--signal); }

  .demo-list { list-style: none; margin: 1.4rem 0 0; padding: 0; }
  .demo-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 0.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    flex-wrap: wrap;
  }
  .demo-list li:first-child .demo-row { border-top: 1px solid var(--line); }
  .demo-row:hover { background: color-mix(in srgb, var(--surface) 65%, transparent); }
  .demo-row:hover .demo-go { transform: translateX(4px); color: var(--signal); }
  .demo-name { font-weight: 600; flex: 1 1 14rem; }
  .demo-go { margin-left: auto; color: var(--dim); transition: transform 0.15s ease; }

  .more-link { margin-top: 1rem; font-size: 0.8rem; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .plain-list { list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .plain-list li { margin-bottom: 1.1rem; }
  .plain-list li > a { font-weight: 600; font-size: 1.02rem; }
  .plain-list li p { margin: 0.15rem 0 0; font-size: 0.88rem; color: var(--dim); }
  .post-date { font-size: 0.72rem; }

  .contact { padding-bottom: 1rem; }
  .contact-statement {
    font-family: var(--font-prose);
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    line-height: 1.3;
    max-width: 34ch;
    margin: 0.8rem 0 0;
    letter-spacing: -0.01em;
  }
  .contact-statement em {
    font-style: italic;
    color: var(--petrol);
  }
  .contact-links {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; padding-top: 2.5rem; gap: 2rem; }
    .split { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
