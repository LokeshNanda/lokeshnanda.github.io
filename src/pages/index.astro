---
import Base from '../layouts/Base.astro';
import Manifest from '../components/Manifest.astro';
import { getCollection } from 'astro:content';
import catalog from '../../data/catalog.json';

const apps = catalog.items.filter((i) => i.category === 'app');
const demos = catalog.items.filter((i) => i.category === 'demo');
const learning = catalog.items.filter((i) => i.category === 'learning');

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const notes = (await getCollection('learnings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base title="Lokesh Nanda — data, cloud & AI products">
  <!-- Hero -->
  <div class="hero-bleed">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">Data · Cloud · AI products</p>
        <h1 class="display">
          I build apps, AI products and data platforms.
          <em class="serif-turn">Explore them, live, on this site.</em>
        </h1>
        <p class="lede">
          I'm Lokesh — an engineer with twelve years across data and AI. Here you'll find apps
          you can use today, interactive demos from different industries, and a weekly blog of
          what I'm learning.
        </p>
        <p class="hero-actions">
          <a class="btn btn-primary" href="/demos/">Explore my work</a>
          <a class="btn" href="/resume/">View my resume</a>
          <button class="btn" id="chat-open" type="button">Ask about my work</button>
        </p>
      </div>
      <div class="hero-manifest">
        <Manifest />
      </div>
    </section>
  </div>

  <!-- Apps -->
  <section class="wrap section" id="apps">
    <p class="eyebrow">Apps</p>
    <h2 class="section-title">Tools I built because I needed them</h2>
    <div class="card-grid">
      {apps.map((app) => (
        <a class="card" href={app.url}>
          <h3>{app.name}</h3>
          <p class="card-domain">{app.domain}</p>
          <p class="card-desc">{app.description}</p>
          <span class="card-go">Try it →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive demos -->
  <section class="wrap section" id="demos">
    <p class="eyebrow">Interactive demos</p>
    <h2 class="section-title">Dashboards from different industries</h2>
    <p class="section-note">
      Banking, retail, public safety, elections and more — built with realistic sample data,
      so you're free to click around.
    </p>
    <ul class="demo-list">
      {demos.map((demo) => (
        <li>
          <a class="demo-row" href={demo.url}>
            <span class="demo-name">{demo.name}</span>
            <span class="badge badge-domain">{demo.domain}</span>
            <span class="badge badge-simulated">sample data</span>
            <span class="demo-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="more-link"><a href="/demos/">See the full collection →</a></p>
  </section>

  <!-- Writing + notes -->
  <section class="wrap section split" id="writing">
    <div>
      <p class="eyebrow">Blog</p>
      <h2 class="section-title">Deep dives</h2>
      <ul class="plain-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="post-date">{fmt(post.data.date)}</p>
          </li>
        ))}
      </ul>
      <p class="more-link"><a href="/blog/">All articles →</a></p>
    </div>
    <div>
      <p class="eyebrow">Weekly learnings</p>
      <h2 class="section-title">This week I learned</h2>
      <ul class="plain-list">
        {notes.map((note) => (
          <li>
            <a href={`/learnings/${note.id}/`}>{note.data.title}</a>
            <p class="post-date">{fmt(note.data.date)}</p>
          </li>
        ))}
      </ul>
      <p class="more-link"><a href="/learnings/">All learnings →</a></p>
    </div>
    <div>
      <p class="eyebrow">Engineering notes</p>
      <h2 class="section-title">How I think about building</h2>
      <ul class="plain-list">
        {learning.map((item) => (
          <li>
            <a href={item.url}>{item.name}</a>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section class="wrap section contact" id="contact">
    <p class="eyebrow">Get in touch</p>
    <p class="contact-statement">
      Want to talk data, AI, or an idea you're exploring?
      <em>I'm always open to a good conversation.</em>
    </p>
    <p class="contact-actions">
      <a class="btn btn-primary" href="mailto:hello@lokeshnanda.com">Say hello</a>
      <a class="btn" href="https://www.linkedin.com/in/lokeshnanda/">Connect on LinkedIn</a>
    </p>
  </section>
</Base>

<style>
  .hero-bleed {
    position: relative;
    overflow: hidden;
  }
  /* Soft colour washes behind the hero, faded out before content sections */
  .hero-bleed::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38rem 22rem at 82% 0%, color-mix(in srgb, var(--primary) 9%, transparent), transparent 70%),
      radial-gradient(30rem 18rem at 8% 100%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero-bleed > .hero {
    position: relative;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }
  .hero-copy .eyebrow { margin-bottom: 1rem; }
  .serif-turn {
    display: block;
    font-family: var(--font-prose);
    font-style: italic;
    font-weight: 500;
    color: var(--primary);
    letter-spacing: -0.01em;
    margin-top: 0.2rem;
  }
  .lede { margin-top: 1.2rem; }
  .hero-actions { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.65rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .btn:hover { border-color: var(--primary); color: var(--primary); }
  .btn-primary {
    background: var(--primary);
    border-color: var(--primary);
    color: #f7f6ff;
  }
  .btn-primary:hover { background: var(--primary-deep); border-color: var(--primary-deep); color: #f7f6ff; }

  .section { padding-top: 3.5rem; }
  .section .eyebrow { margin-bottom: 0.4rem; }
  .section-note { color: var(--dim); max-width: 40rem; margin-top: 0.5rem; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--primary); transform: translateY(-2px); }
  .card h3 { font-size: 1.05rem; font-weight: 650; }
  .card-domain { font-size: 0.78rem; font-weight: 600; color: var(--primary); margin: 0; }
  .card-desc { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--dim); flex: 1; }
  .card-go { font-size: 0.85rem; font-weight: 600; color: var(--dim); margin-top: 0.8rem; }
  .card:hover .card-go { color: var(--accent); }

  .demo-list { list-style: none; margin: 1.4rem 0 0; padding: 0; }
  .demo-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    flex-wrap: wrap;
  }
  .demo-list li:first-child .demo-row { border-top: 1px solid var(--line); }
  .demo-row:hover { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .demo-row:hover .demo-go { transform: translateX(4px); color: var(--accent); }
  .demo-name { font-weight: 600; flex: 1 1 14rem; }
  .demo-go { margin-left: auto; color: var(--dim); transition: transform 0.15s ease; }

  .more-link { margin-top: 1.2rem; font-size: 0.9rem; font-weight: 600; }

  .split {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .plain-list { list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .plain-list li { margin-bottom: 1.1rem; }
  .plain-list li > a { font-weight: 600; font-size: 1.02rem; }
  .plain-list li p { margin: 0.15rem 0 0; font-size: 0.88rem; color: var(--dim); }
  .post-date { font-size: 0.78rem; }

  .contact { padding-bottom: 1rem; }
  .contact-statement {
    font-family: var(--font-prose);
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    line-height: 1.35;
    max-width: 40ch;
    margin: 0.8rem 0 0;
    letter-spacing: -0.01em;
  }
  .contact-statement em {
    font-style: italic;
    color: var(--primary);
  }
  .contact-actions { display: flex; gap: 0.8rem; margin-top: 1.6rem; flex-wrap: wrap; }

  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; padding-top: 2.5rem; gap: 2rem; }
    .split { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
