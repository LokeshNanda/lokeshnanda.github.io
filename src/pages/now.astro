---
import Base from '../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import books from '../../data/books.json';
import habits from '../../data/habits.json';

// Building — repos pushed recently (pushedAt arrives via catalog-sync)
const ACTIVE_WINDOW_MS = 45 * 24 * 60 * 60 * 1000;
const active = catalog.items.filter(
  (i) =>
    'pushedAt' in i &&
    typeof (i as any).pushedAt === 'string' &&
    Date.now() - new Date((i as any).pushedAt).valueOf() < ACTIVE_WINDOW_MS
);

// Reading — from the shelf
const reading = (books.items as any[]).filter((b) => b.status === 'reading');

// Gym — list of gym dates (YYYY-MM-DD). Rendered client-side from this
// fallback first, then redrawn from the Worker's live list.
const gymDates = (habits.gym.dates as string[]).filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(d)).sort();

const updated = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Live gym dates pushed by the rep-log PWA via the Worker; the inline
// fallback list keeps the grid drawn when the API is unreachable.
const GYM_API = import.meta.env.DEV
  ? 'http://localhost:8787/gym'
  : 'https://api.lokeshnanda.com/gym';
---

<Base
  title="Now — Lokesh Nanda"
  description="What Lokesh Nanda is doing now: building, reading, and staying consistent with workouts."
>
  <section class="wrap now">
    <p class="eyebrow">Now</p>
    <h1 class="display">What I'm up to</h1>
    <p class="lede">
      The current snapshot — building, reading, training. Like everything on this site, it
      updates from real data.
    </p>

    <h2 class="now-section">Building</h2>
    {active.length > 0 ? (
      <ul class="now-list">
        {active.map((i) => (
          <li>
            <a href={i.url}>{i.name}</a>
            <span class="now-dim"> — {i.description}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="now-dim">
        Between pushes — everything I've shipped is on the <a href="/demos/">work page</a>.
      </p>
    )}

    <h2 class="now-section">Reading</h2>
    {reading.length > 0 ? (
      <ul class="now-list">
        {reading.map((b) => (
          <li>
            <strong>{b.title}</strong>
            <span class="now-dim"> — {b.author}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="now-dim">
        Between books — the full shelf lives at <a href="/reading/">/reading</a>.
      </p>
    )}

    <h2 class="now-section">Workout</h2>
    <div id="gym-live" data-api={GYM_API} data-dates={JSON.stringify(gymDates)}>
      <p class="now-dim">Loading workout days…</p>
    </div>

    <p class="now-footer">
      Updated {updated} · this is a <a href="https://nownownow.com/about">now page</a>
    </p>
  </section>
</Base>

<script>
  import { buildYear, yearRange, weekCount } from '../lib/gym-year.js';

  const root = document.getElementById('gym-live')!;
  const now = new Date();
  const today = [now.getFullYear(), now.getMonth() + 1, now.getDate()]
    .map((n) => String(n).padStart(2, '0'))
    .join('-');
  const currentYear = Number(today.slice(0, 4));
  const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  let dates: string[] = JSON.parse(root.dataset.dates ?? '[]');
  let year = currentYear;
  let live = false;

  const nice = (d: string) =>
    new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    });

  function render() {
    const y = buildYear(dates, year);
    const years = yearRange(dates, currentYear);
    const thisWeek = weekCount(dates, today);
    const prev = years.includes(year - 1);
    const next = years.includes(year + 1);

    const labels = y.months
      .map((m) => `<span style="grid-column:${m.col + 1}"><b>${m.label}</b><i>${m.count}</i></span>`)
      .join('');
    const cells = y.weeks
      .map((w) =>
        w
          .map((c, d) =>
            c
              ? `<i class="${c.on ? 'on' : ''}" title="${DOW[d]} ${nice(c.date)}${c.on ? ' · gym' : ''}"></i>`
              : '<i class="pad"></i>'
          )
          .join('')
      )
      .join('');

    root.innerHTML =
      `<div class="gym">` +
      `<div class="gym-head">` +
      `<p class="gym-line"><strong>${y.total}</strong> day${y.total === 1 ? '' : 's'} in ${year}` +
      (year === currentYear ? `<span class="now-dim"> · ${thisWeek} this week</span>` : '') +
      `</p>` +
      `<div class="gym-nav">` +
      `<button type="button" data-step="-1" aria-label="Previous year" ${prev ? '' : 'disabled'}>&larr;</button>` +
      `<span>${year}</span>` +
      `<button type="button" data-step="1" aria-label="Next year" ${next ? '' : 'disabled'}>&rarr;</button>` +
      `</div></div>` +
      `<div class="gym-scroll"><div class="gym-year" style="--cols:${y.weeks.length}">` +
      `<div class="gym-months">${labels}</div>` +
      `<div class="gym-days" role="img" aria-label="${y.total} workout days in ${year}, one dot per day">${cells}</div>` +
      `</div></div>` +
      (live ? `<p class="now-dim gym-note">Live from my workout logger</p>` : '') +
      `</div>`;

    root.querySelectorAll<HTMLButtonElement>('.gym-nav button').forEach((b) =>
      b.addEventListener('click', () => {
        year += Number(b.dataset.step);
        render();
      })
    );
  }

  render();

  fetch(root.dataset.api!)
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((data) => {
      const incoming = Array.isArray(data?.dates) ? data.dates : [];
      const clean = incoming.filter((d: unknown) => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d));
      if (clean.length === 0) return;
      dates = [...new Set<string>(clean)].sort();
      live = true;
      render();
    })
    .catch(() => {});
</script>

<style is:global>
  .now { padding-top: 3.5rem; max-width: 46rem; }
  .now .display { margin-top: 0.6rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .now .lede { margin-top: 1rem; }
  .now-section {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 2.6rem 0 0.8rem;
  }
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .now-dim { color: var(--dim); }
  .gym-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .gym-line { margin: 0; }
  .gym-line strong { color: var(--primary); font-size: 1.3rem; }
  .gym-nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .gym-nav button {
    font: inherit;
    line-height: 1;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .gym-nav button:hover:not(:disabled) { color: var(--primary); border-color: var(--primary); }
  .gym-nav button:disabled { opacity: 0.35; cursor: default; }
  .gym-scroll { overflow-x: auto; padding-bottom: 0.4rem; }
  .gym-year {
    --cell: 0.6rem;
    --gap: 0.2rem;
    display: grid;
    gap: 0.35rem;
    width: max-content;
  }
  .gym-months {
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--cell));
    gap: var(--gap);
    font-size: 0.7rem;
    line-height: 1.1;
    color: var(--dim);
  }
  .gym-months span { grid-row: 1; white-space: nowrap; }
  .gym-months b { font-weight: 600; display: block; }
  .gym-months i { font-style: normal; display: block; }
  .gym-days {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
  }
  .gym-days i {
    width: var(--cell);
    height: var(--cell);
    border-radius: 2px;
    background: color-mix(in srgb, var(--line) 70%, transparent);
  }
  .gym-days i.on { background: var(--primary); }
  .gym-days i.pad { background: transparent; }
  .gym-note { margin-top: 0.6rem; font-size: 0.8rem; }
  .now-footer {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--dim);
  }
</style>
