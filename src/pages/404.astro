---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Lokesh Nanda">
  <section class="wrap nf">
    <p class="mono nf-code">HTTP 404 · route not in manifest</p>
    <h1 class="display">This page doesn't exist.</h1>
    <p class="lede">
      The link may be old, or the page moved. Start from the <a href="/">homepage</a> or browse
      the <a href="/demos/">work catalog</a>.
    </p>
  </section>
</Base>

<style>
  .nf { padding-top: 6rem; }
  .nf-code { color: var(--signal); font-size: 0.78rem; margin-bottom: 1rem; }
</style>
