---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Lokesh Nanda">
  <section class="wrap nf">
    <p class="eyebrow nf-code">Page not found</p>
    <h1 class="display">This page doesn't exist.</h1>
    <p class="lede">
      The link may be old, or the page has moved. Start from the <a href="/">homepage</a> or
      <a href="/demos/">explore my work</a>.
    </p>
  </section>
</Base>

<style>
  .nf { padding-top: 6rem; }
  .nf-code { color: var(--accent); margin-bottom: 1rem; }
</style>
