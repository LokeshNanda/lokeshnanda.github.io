---
import Base from '../layouts/Base.astro';
import catalog from '../../data/catalog.json';

const items = catalog.items;

// "Active" = pushed to within the last 45 days (pushedAt arrives via catalog-sync)
const ACTIVE_WINDOW_MS = 45 * 24 * 60 * 60 * 1000;
const isActive = (item: (typeof items)[number]) =>
  'pushedAt' in item &&
  typeof item.pushedAt === 'string' &&
  Date.now() - new Date(item.pushedAt).valueOf() < ACTIVE_WINDOW_MS;

const categories = [
  { key: 'all', label: 'Everything' },
  { key: 'app', label: 'Apps' },
  { key: 'demo', label: 'Demos' },
  { key: 'learning', label: 'Learning' },
];
const categoryNames = { app: 'App', demo: 'Demo', learning: 'Learning' };
---

<Base
  title="Work — Lokesh Nanda"
  description="Apps to try, interactive dashboards to explore, and learning projects by Lokesh Nanda."
>
  <section class="wrap catalog-head">
    <p class="eyebrow">Work</p>
    <h1 class="display">Explore my work</h1>
    <p class="lede">
      Apps to try, dashboards to explore and projects I'm learning from. This page updates
      itself whenever I publish something new. Demos use realistic sample data, so click
      around freely.
    </p>

    <div class="filters" role="group" aria-label="Filter by category">
      {categories.map((c) => (
        <button class="filter" data-filter={c.key} aria-pressed={c.key === 'all' ? 'true' : 'false'}>
          {c.label}
        </button>
      ))}
    </div>
  </section>

  <section class="wrap">
    <ul class="catalog-list">
      {items.map((item) => (
        <li class="catalog-item" data-category={item.category}>
          <a class="row" href={item.url}>
            <div class="row-main">
              <span class="row-name">{item.name}</span>
              <p class="row-desc">{item.description}</p>
            </div>
            <div class="row-meta">
              {isActive(item) && <span class="badge badge-active">actively developed</span>}
              <span class="badge badge-domain">{item.domain}</span>
              <span class={`badge ${item.data === 'simulated' ? 'badge-simulated' : 'badge-real'}`}>
                {item.data === 'simulated' ? 'sample data' : 'live'}
              </span>
              <span class="row-cat">{categoryNames[item.category]}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="small-note" id="count-note">{items.length} items</p>
  </section>
</Base>

<script>
  // Bound on astro:page-load: the module runs once, but view transitions
  // rebuild this page's DOM on every visit, so the fresh buttons need fresh
  // listeners. The element check skips the handler on every other page.
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
    if (buttons.length === 0) return;
    const rows = document.querySelectorAll<HTMLElement>('.catalog-item');
    const note = document.getElementById('count-note');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        rows.forEach((row) => {
          const show = key === 'all' || row.dataset.category === key;
          row.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        if (note) note.textContent = `${shown} item${shown === 1 ? '' : 's'}`;
      });
    });

    // Deep links like /demos/?filter=app pre-select a category
    const requested = new URLSearchParams(location.search).get('filter');
    if (requested && requested !== 'all') {
      document.querySelector<HTMLButtonElement>(`.filter[data-filter="${CSS.escape(requested)}"]`)?.click();
    }
  });
</script>

<style>
  .catalog-head { padding-top: 3.5rem; }
  .catalog-head .display { margin-top: 0.6rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .catalog-head .lede { margin-top: 1rem; }

  .filters { display: flex; gap: 0.5rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .filter {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--dim);
    cursor: pointer;
  }
  .filter:hover { border-color: var(--primary); color: var(--primary); }
  .filter[aria-pressed='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: #f7f6ff;
  }

  .catalog-list { list-style: none; margin: 2rem 0 0; padding: 0; }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    flex-wrap: wrap;
  }
  .catalog-item:first-child .row { border-top: 1px solid var(--line); }
  .row:hover { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .row:hover .row-name { color: var(--primary); }
  .row-main { flex: 1 1 22rem; min-width: 0; }
  .row-name { font-weight: 650; font-size: 1.05rem; }
  .row-desc { margin: 0.2rem 0 0; font-size: 0.88rem; color: var(--dim); }
  .row-meta { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .row-cat { font-size: 0.78rem; color: var(--dim); width: 4.5rem; text-align: right; }

  #count-note { margin-top: 1rem; }

  @media (max-width: 640px) {
    .row-cat { display: none; }
  }
</style>
