---
// "At a glance" panel — the numbers are generated from real site data at
// build time, so this card is always accurate without anyone editing it.
import { getCollection } from 'astro:content';
import catalog from '../../data/catalog.json';
import books from '../../data/books.json';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const learnings = await getCollection('learnings', ({ data }) => !data.draft);
const apps = catalog.items.filter((i) => i.category === 'app').length;
const demos = catalog.items.filter((i) => i.category === 'demo').length;

const year = String(new Date().getFullYear());
const booksThisYear = (books.items as any[]).filter(
  (b) => b.status === 'finished' && b.finished?.startsWith(year)
).length;

const updated = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const facts = [
  { value: apps, label: apps === 1 ? 'app you can try' : 'apps you can try', href: '/demos/?filter=app' },
  { value: demos, label: demos === 1 ? 'interactive demo' : 'interactive demos', href: '/demos/?filter=demo' },
  { value: posts.length, label: posts.length === 1 ? 'deep-dive article' : 'deep-dive articles', href: '/blog/' },
  { value: learnings.length, label: learnings.length === 1 ? 'weekly learning' : 'weekly learnings', href: '/learnings/' },
  // Appears once the reading shelf has finished books this year
  ...(booksThisYear > 0
    ? [{ value: booksThisYear, label: booksThisYear === 1 ? 'book read this year' : 'books read this year', href: '/reading/' }]
    : []),
];
---

<aside class="glance" aria-label="This site at a glance">
  <p class="glance-head eyebrow">At a glance</p>
  <ul>
    {facts.map((fact, i) => (
      <li style={`--i: ${i}`}>
        <a class="glance-link" href={fact.href}>
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
          <span class="glance-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="glance-updated">Updated {updated} · refreshes itself with every new project</p>
</aside>

<style>
  .glance {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem 1.3rem;
    box-shadow: var(--shadow);
  }
  .glance-head {
    margin: 0 0 0.9rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-bottom: 1px solid var(--line);
    animation: rise 0.5s ease both;
    animation-delay: calc(var(--i) * 90ms);
  }
  li:last-of-type { border-bottom: none; }
  .glance-link {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.45rem 0.2rem;
    text-decoration: none;
    border-radius: 6px;
  }
  .glance-link:hover span { color: var(--primary); }
  .glance-arrow {
    margin-left: auto;
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .glance-link:hover .glance-arrow {
    opacity: 1;
    transform: translateX(2px);
  }
  strong {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--primary);
    min-width: 1.6rem;
  }
  span {
    color: var(--dim);
    font-size: 0.95rem;
  }
  .glance-updated {
    margin: 0.9rem 0 0;
    font-size: 0.76rem;
    color: var(--dim);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
</style>
