---
// Profile chat — vanilla-JS island, homepage only. See docs/superpowers/specs/2026-08-21-chatbot-design.md.
const ENDPOINT = import.meta.env.DEV
  ? 'http://localhost:8787/chat'
  : 'https://api.lokeshnanda.com/chat';
// Dev uses Cloudflare's invisible always-pass test sitekey (pairs with the
// test secret in workers/chat/.dev.vars). Real key filled in Task 4.
const SITEKEY = import.meta.env.DEV
  ? '1x00000000000000000000BB'
  : '0x4AAAAAAEXwCVn1-WWI8aEY';
---

<button class="chat-fab" id="chat-fab" type="button" aria-label="Chat about Lokesh's work">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
</button>

<div class="chat-root" id="chat-root" data-endpoint={ENDPOINT} data-sitekey={SITEKEY} hidden>
  <section class="chat-panel" role="dialog" aria-label="Chat about Lokesh's work">
    <header class="chat-head">
      <strong>Ask about my work</strong>
      <button class="chat-close" id="chat-close" type="button" aria-label="Close chat">×</button>
    </header>
    <div class="chat-log" id="chat-log" aria-live="polite">
      <div class="msg-group msg-group-bot">
        <span class="avatar avatar-bot" aria-hidden="true">LN</span>
        <div class="msg msg-bot">Hi! Ask me anything about Lokesh's experience, projects or skills.</div>
      </div>
      <div class="chat-suggestions" id="chat-suggestions">
        <button type="button" class="chat-chip">What has he built with AI?</button>
        <button type="button" class="chat-chip">What is his data engineering experience?</button>
        <button type="button" class="chat-chip">Is he open to new opportunities?</button>
      </div>
    </div>
    <form class="chat-form" id="chat-form">
      <input
        class="chat-input" id="chat-input" type="text" maxlength="500"
        placeholder="e.g. What has he built with AI?" autocomplete="off"
      />
      <button class="chat-send" type="submit">Send</button>
    </form>
    <div id="turnstile-slot"></div>
    <p class="chat-note">
      AI answers based on Lokesh's resume — double-check anything important on the
      <a href="/resume/">resume</a>.
    </p>
  </section>
</div>

<script>
  const root = document.getElementById('chat-root')!;
  const log = document.getElementById('chat-log')!;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const send = form.querySelector('.chat-send') as HTMLButtonElement;
  const ENDPOINT = root.dataset.endpoint!;
  const SITEKEY = root.dataset.sitekey!;

  const sessionId = crypto.randomUUID();
  const messages: { role: 'user' | 'assistant'; content: string }[] = [];

  let widgetId: string | null = null;
  let tokenResolve: ((t: string) => void) | null = null;
  let tokenReject: ((e: Error) => void) | null = null;
  let turnstileReady: Promise<void> | null = null;

  function loadTurnstile(): Promise<void> {
    if (turnstileReady) return turnstileReady;
    turnstileReady = new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => {
        try {
          widgetId = (window as any).turnstile.render('#turnstile-slot', {
            sitekey: SITEKEY,
            execution: 'execute', // invisible: only runs when we ask for a token
            callback: (t: string) => tokenResolve?.(t),
            'error-callback': () => tokenReject?.(new Error('turnstile')),
          });
          resolve();
        } catch (e) {
          turnstileReady = null;
          reject(e instanceof Error ? e : new Error('turnstile render'));
        }
      };
      s.onerror = () => {
        turnstileReady = null;
        reject(new Error('turnstile script'));
      };
      document.head.appendChild(s);
    });
    return turnstileReady;
  }

  async function getToken(): Promise<string> {
    await loadTurnstile();
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error('turnstile timeout')), 15000);
      tokenResolve = (t: string) => {
        clearTimeout(timer);
        resolve(t);
      };
      tokenReject = (e: Error) => {
        clearTimeout(timer);
        reject(e);
      };
      (window as any).turnstile.reset(widgetId);
      (window as any).turnstile.execute(widgetId);
    });
  }

  const USER_ICON =
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 12a4.5 4.5 0 1 0-4.5-4.5A4.5 4.5 0 0 0 12 12zm0 2.25c-3 0-9 1.5-9 4.5V21h18v-2.25c0-3-6-4.5-9-4.5z"/></svg>';

  function bubble(kind: 'user' | 'bot', text: string): HTMLElement {
    const group = document.createElement('div');
    group.className = `msg-group msg-group-${kind}`;
    const avatar = document.createElement('span');
    avatar.className = `avatar avatar-${kind}`;
    avatar.setAttribute('aria-hidden', 'true');
    if (kind === 'bot') {
      avatar.textContent = 'LN';
    } else {
      avatar.innerHTML = USER_ICON; // static icon markup, never user input
    }
    const el = document.createElement('div');
    el.className = `msg msg-${kind}`;
    el.textContent = text;
    group.append(avatar, el);
    log.appendChild(group);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Minimal, safe markdown for assistant replies: everything is HTML-escaped
  // first, then only bold, inline code, links, bullets/numbered lists and
  // headings are converted. No raw model output ever reaches innerHTML
  // unescaped, and links only render for this site's own pages.
  const SAFE_HREF = /^(\/|https:\/\/(www\.)?lokeshnanda\.com([/?#]|$))/;

  function renderMarkdown(text: string): string {
    const inline = (s: string) =>
      escapeHtml(s)
        .replace(/\[([^\]]+)\]\(([^\s)"'`]+)\)/g, (m, label, href) =>
          SAFE_HREF.test(href)
            ? `<a href="${href}" target="_blank" rel="noopener">${label}</a>`
            : label
        )
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`]+)`/g, '<code>$1</code>');
    const out: string[] = [];
    let list: string[] | null = null;
    for (const line of text.split('\n')) {
      const item = line.match(/^\s*(?:[-*]|\d+\.)\s+(.*)/);
      if (item) {
        (list ??= []).push(`<li>${inline(item[1])}</li>`);
        continue;
      }
      if (list) {
        out.push(`<ul>${list.join('')}</ul>`);
        list = null;
      }
      const heading = line.match(/^\s*#{1,6}\s+(.*)/);
      if (heading) {
        out.push(`<p><strong>${inline(heading[1])}</strong></p>`);
      } else if (line.trim()) {
        out.push(`<p>${inline(line)}</p>`);
      }
    }
    if (list) out.push(`<ul>${list.join('')}</ul>`);
    return out.join('');
  }

  async function ask(question: string) {
    messages.push({ role: 'user', content: question });
    bubble('user', question);
    const reply = bubble('bot', '');
    reply.innerHTML =
      '<span class="typing" aria-label="Assistant is typing"><i></i><i></i><i></i></span>';
    input.value = '';
    input.disabled = true;
    send.disabled = true;

    document.getElementById('chat-suggestions')?.remove();

    try {
      const turnstileToken = await getToken();
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages, turnstileToken, sessionId }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        reply.textContent = data.error ?? 'The assistant is unavailable right now. Try again later.';
        return;
      }

      reply.textContent = '';
      const reader = res.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let text = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() ?? '';
        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const payload = line.slice(6).trim();
          if (payload === '[DONE]') continue;
          try {
            text += JSON.parse(payload).choices?.[0]?.delta?.content ?? '';
          } catch {
            /* keep-alive / partial line */
          }
          reply.innerHTML = renderMarkdown(text);
          log.scrollTop = log.scrollHeight;
        }
      }
      messages.push({ role: 'assistant', content: text });
    } catch {
      reply.textContent = 'Something went wrong — give it another try in a moment.';
    } finally {
      input.disabled = false;
      send.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q && !input.disabled) ask(q);
  });

  // Starter questions — one click to ask; the chips leave once the
  // conversation has started.
  const suggestions = document.getElementById('chat-suggestions');
  suggestions?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest('.chat-chip');
    if (!chip || input.disabled) return;
    suggestions.remove();
    ask(chip.textContent!.trim());
  });

  const fab = document.getElementById('chat-fab') as HTMLButtonElement;

  function openChat() {
    root.hidden = false;
    fab.hidden = true;
    loadTurnstile().catch(() => {});
    input.focus();
  }
  function closeChat() {
    root.hidden = true;
    fab.hidden = false;
  }

  document.getElementById('chat-open')?.addEventListener('click', openChat);
  fab.addEventListener('click', openChat);
  document.getElementById('chat-close')?.addEventListener('click', closeChat);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !root.hidden) closeChat();
  });
</script>

<style is:global>
  /*
    is:global is required: message bubbles are built with document.createElement,
    which never receives Astro's scoping attribute — scoped CSS would skip them.
    Every selector stays namespaced under .chat-root / .chat-fab, so nothing leaks.
  */
  .chat-root {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    width: min(24rem, calc(100vw - 2rem));
  }
  .chat-panel {
    display: flex;
    flex-direction: column;
    height: min(30rem, 75vh);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.18);
    overflow: hidden;
  }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .chat-close {
    border: 0;
    background: none;
    font-size: 1.3rem;
    color: var(--dim);
    cursor: pointer;
    line-height: 1;
  }
  .chat-close:hover { color: var(--ink); }
  .chat-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    width: 3.5rem;
    height: 3.5rem;
    border: 0;
    border-radius: 50%;
    background: var(--primary);
    color: #f7f6ff;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.22);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .chat-fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.26);
  }
  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .chat-log .msg-group {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    max-width: 88%;
  }
  .chat-log .msg-group-user { align-self: flex-end; flex-direction: row-reverse; }
  .chat-log .msg-group-bot { align-self: flex-start; }
  .chat-log .avatar {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    user-select: none;
  }
  .chat-log .avatar-bot {
    background: var(--primary);
    color: #f7f6ff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .chat-log .avatar-user {
    background: var(--primary-wash);
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
  }
  .chat-log .msg {
    min-width: 0;
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    font-size: 0.92rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .chat-log .msg-user {
    background: var(--primary);
    color: #f7f6ff;
    border-bottom-right-radius: 4px;
    white-space: pre-wrap;
  }
  .chat-log .msg-bot {
    background: color-mix(in srgb, var(--line) 45%, transparent);
    border: 1px solid var(--line);
    color: var(--ink);
    border-bottom-left-radius: 4px;
  }
  .chat-log .msg-bot p { margin: 0 0 0.5em; }
  .chat-log .msg-bot p:last-child { margin-bottom: 0; }
  .chat-log .msg-bot ul {
    margin: 0.2em 0 0.5em;
    padding-left: 1.15rem;
  }
  .chat-log .msg-bot ul:last-child { margin-bottom: 0; }
  .chat-log .msg-bot li { margin: 0.18em 0; }
  .chat-log .msg-bot code {
    font-size: 0.85em;
    background: color-mix(in srgb, var(--line) 50%, transparent);
    padding: 0.08em 0.35em;
    border-radius: 4px;
  }
  .chat-log .msg-bot a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .chat-log .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-left: 2.25rem;
  }
  .chat-log .chat-chip {
    border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);
    border-radius: 999px;
    background: var(--primary-wash);
    color: var(--primary);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 550;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .chat-log .chat-chip:hover {
    background: color-mix(in srgb, var(--primary) 18%, var(--primary-wash));
  }
  .chat-log .typing {
    display: inline-flex;
    gap: 0.28rem;
    align-items: center;
    padding: 0.15rem 0;
  }
  .chat-log .typing i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--dim);
    animation: chat-typing 1.1s ease-in-out infinite;
  }
  .chat-log .typing i:nth-child(2) { animation-delay: 0.18s; }
  .chat-log .typing i:nth-child(3) { animation-delay: 0.36s; }
  @keyframes chat-typing {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }
  .chat-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .chat-input {
    flex: 1;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.92rem;
  }
  .chat-input:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
  .chat-send {
    border: 0;
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    background: var(--primary);
    color: #f7f6ff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .chat-send:disabled { opacity: 0.5; cursor: default; }
  .chat-note {
    margin: 0;
    padding: 0 1rem 0.8rem;
    font-size: 0.72rem;
    color: var(--dim);
  }
</style>
