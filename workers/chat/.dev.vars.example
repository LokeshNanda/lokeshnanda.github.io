# Copy to .dev.vars (same folder) for `wrangler dev`. NEVER commit .dev.vars.
ALLOWED_ORIGIN=http://localhost:4321
# Turnstile test pair: any token passes verification in dev.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Real keys (optional locally; required for end-to-end dev chat):
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPIK_API_KEY=REPLACE_ME
OPIK_WORKSPACE=REPLACE_ME
# note-log sync token: same value as the production secret, so the
# weekly-note skill can pull pending notes from /inbox.
CAPTURE_SYNC_TOKEN=REPLACE_ME
# Token for POST /reindex (syncs Vectorize with the bundled corpus).
# Create the production one with `npx wrangler secret put REINDEX_TOKEN`.
REINDEX_TOKEN=REPLACE_ME
# Set to "off" to compare against the old prompt-stuffing behaviour.
RETRIEVAL=on
# Sentry DSN (optional; empty disables error reporting). Usually left empty in
# dev so local crashes stay out of the production project's quota.
SENTRY_DSN=
